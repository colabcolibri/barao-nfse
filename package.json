{
  "name": "barao-nfse",
  "version": "2.1.0",
  "description": "Barão NFS-e — Emissor local de NFS-e Padrão Nacional (Sefin Nacional / ADN)",
  "main": "src/server.js",
  "scripts": {
    "prestart": "lsof -ti :3333 | xargs kill -9 2>/dev/null || true",
    "start": "node src/server.js",
    "predev": "lsof -ti :3334 -ti :5173 | xargs kill -9 2>/dev/null || true",
    "dev": "concurrently -n api,web -c cyan,magenta \"NODE_ENV=development PORT=3334 node --watch src/server.js\" \"vite --host 127.0.0.1 --port 5173\"",
    "build": "vite build",
    "test": "node --test test/*.test.js",
    "service:install": "bash scripts/install-launchd.sh",
    "service:stop": "launchctl bootout gui/$(id -u)/com.barao.emissor-nfse",
    "service:start": "launchctl kickstart -k gui/$(id -u)/com.barao.emissor-nfse",
    "service:logs": "tail -f data/logs/stdout.log data/logs/stderr.log"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fastify/static": "^8.1.0",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "fastify": "^5.2.1",
    "lucide-react": "^0.475.0",
    "next-themes": "^0.4.6",
    "pdfkit": "^0.21.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.23.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.1",
    "tw-animate-css": "^1.4.0",
    "xml-crypto": "^6.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.6",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
